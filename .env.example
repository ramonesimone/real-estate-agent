# ── REQUIRED ──────────────────────────────────────────────────
# OpenRouter (replaces direct Anthropic API)
OPENROUTER_API_KEY=

# Database — SQLite (zero setup, default) or PostgreSQL
# For SQLite:  DATABASE_PROVIDER=sqlite   DATABASE_URL=file:./dev.db
# For Postgres: DATABASE_PROVIDER=postgresql   DATABASE_URL=postgresql://user:pass@localhost:5432/realestate
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# ── OPTIONAL (with fallbacks) ─────────────────────────────────
# Redis — if not set, uses in-memory queues (jobs lost on restart)
REDIS_URL=

# Twilio — if not set, messages log to console (demo mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# WhatsApp Cloud API (alternative to Twilio)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# Email
RESEND_API_KEY=

# ── FRONTEND ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── AGENT ─────────────────────────────────────────────────────
AGENCY_NAME=Premium Properties
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
DEFAULT_TIMEZONE=America/New_York
